{% extends 'Template/StandardTemplate.html.twig' %}
{% import 'Template/Macros/forum.html.twig' as forum %}
{% import 'Template/Macros/breadcrumb.html.twig' as breadcrumb %}

{% block title %}{{ board.title }}{% endblock %}

{% block breadcrumb %}
    {{ breadcrumb.item('Diskussionen', path('caldera_criticalmass_board_overview')) }}
    {{ breadcrumb.active(board.title) }}
{% endblock %}

{% block additionalHeaderElements %}
    {{ parent() }}
    {% if threads.currentPageNumber > 1 %}
        <link rel="prev" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({ 'page': threads.currentPageNumber - 1 })) }}"/>
    {% endif %}
    {% if threads.currentPageNumber < threads.pageCount %}
        <link rel="next" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({ 'page': threads.currentPageNumber + 1 })) }}"/>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">
                <i class="far fa-comments text-muted me-2"></i>
                {{ board.title }}
            </h1>
            {% if app.getUser() %}
                <form method="post" action="{{ subscribeUrl }}" class="d-inline me-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('forum-subscribe') }}">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        <i class="far fa-bell me-1"></i>
                        <span class="d-none d-sm-inline">Forum abonnieren</span>
                    </button>
                </form>
                <a href="{{ newThreadUrl }}" class="btn btn-success btn-sm">
                    <i class="far fa-plus me-1"></i>
                    <span class="d-none d-sm-inline">Neues Thema</span>
                </a>
            {% endif %}
        </div>

        {% if threads|length %}
            {% for thread in threads %}
                <div class="card border-0 shadow-sm mb-3 forum-card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-5">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0 me-3">
                                        {{ forum.avatar(thread.firstPost.user, 40) }}
                                    </div>
                                    <div class="flex-grow-1">
                                        <a href="{{ object_path(thread) }}" class="text-decoration-none">
                                            {% if thread.sticky %}
                                                <i class="fas fa-thumbtack text-muted me-1" title="angeheftet"></i>
                                            {% endif %}
                                            {% if thread.locked %}
                                                <i class="fas fa-lock text-muted me-1" title="geschlossen"></i>
                                            {% endif %}
                                            <strong>{{ thread.title }}</strong>
                                        </a>
                                        <br/>
                                        <small class="text-muted">von {{ thread.firstPost.user.username }}</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2 text-center d-none d-md-block">
                                <span class="d-block text-muted"><small>Antworten</small></span>
                                <strong>{{ thread.postNumber }}</strong>
                            </div>
                            <div class="col-md-5">
                                {% if thread.lastPost %}
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0 me-2">
                                            {{ forum.avatar(thread.lastPost.user, 36) }}
                                        </div>
                                        <div class="flex-grow-1">
                                            <small class="text-muted">
                                                Letzter Beitrag von <strong>{{ thread.lastPost.user.username }}</strong>
                                            </small>
                                            <br/>
                                            <small class="text-muted">
                                                <i class="far fa-clock me-1"></i><span title="{{ thread.lastPost.dateTime|date('d.m.Y, H:i', 'Europe/Berlin') }}">{{ thread.lastPost.dateTime|time_ago }}</span>
                                            </small>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}

            {% if threads.pageCount > 1 %}
                <nav class="d-flex justify-content-center mt-4" aria-label="Seiten">
                    {{ knp_pagination_render(threads) }}
                </nav>
            {% endif %}
        {% else %}
            <div class="text-center py-5">
                <i class="far fa-comments fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Hier gibt es noch nichts zu sehen!</h5>
                <p class="text-muted mb-0">Bislang hat leider noch niemand einen Beitrag in diesem Forum geschrieben.</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
