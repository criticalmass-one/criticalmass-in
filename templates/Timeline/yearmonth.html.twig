{% extends 'Template/StandardTemplate.html.twig' %}
{% import 'Template/Macros/breadcrumb.html.twig' as breadcrumb %}

{% block title %}Critical Mass im {{ startDateTime|format_datetime(pattern='MMMM yyyy') }}{% endblock %}

{% block breadcrumb %}
    {{ breadcrumb.item('Timeline', path('caldera_criticalmass_timeline_index')) }}
    {{ breadcrumb.active(startDateTime|format_datetime(pattern='MMMM yyyy')) }}
{% endblock %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1>
                    Die Critical Mass im {{ startDateTime|format_datetime(pattern='MMMM yyyy') }}
                </h1>

                <p class="lead">
                    Schau dir an, was im {{ startDateTime|format_datetime(pattern='MMMM yyyy') }} bei der Critical Mass passiert
                    ist.
                </p>
            </div>
        </div>

        {{ include('Timeline/_includes/tabs.html.twig') }}

        <div class="row">
            <div class="col-md-12">
                <nav aria-label="Monat Navigation">
                    <ul class="pagination justify-content-between">
                        <li class="page-item{% if not previousDateTime %} disabled{% endif %}">
                            <a class="page-link" href="{% if previousDateTime %}{{ path('caldera_criticalmass_timeline_yearmonth', { year: previousDateTime|date('Y'), month: previousDateTime|date('m') }) }}{% else %}#{% endif %}">
                                &larr; Voriger Monat
                            </a>
                        </li>

                        <li class="page-item{% if not nextDateTime %} disabled{% endif %}">
                            <a class="page-link" href="{% if nextDateTime %}{{ path('caldera_criticalmass_timeline_yearmonth', { year: nextDateTime|date('Y'), month: nextDateTime|date('m') }) }}{% else %}#{% endif %}">
                                Nächster Monat &rarr;
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
{% endblock %}
