<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="row">
            {{ include('Timeline/_includes/user_column.html.twig') }}

            <div class="col-9 col-md-10">
                <p class="mb-2">
                    {% if item.user %}
                        <strong>{{ item.user.username }}</strong>
                        hat in
                    {% else %}
                        Neuer Beitrag in
                    {% endif %}
                    <a href="{{ object_path(item.post.city) }}" class="text-decoration-none">{{ item.post.city.city }}</a>
                    geschrieben:
                </p>

                <p class="text-muted mb-0">
                    <a href="{{ object_path(item.post.city) }}#post-{{ item.post.id }}" class="text-decoration-none text-reset">
                        {{ item.post.text|slice(0, 280) }}{% if item.post.text|length > 280 %}…{% endif %}
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
