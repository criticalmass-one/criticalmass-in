{% extends 'Template/StandardTemplate.html.twig' %}
{% import 'Template/Macros/breadcrumb.html.twig' as breadcrumb %}

{% block title %}Login{% endblock %}

{% block breadcrumb %}
    {{ breadcrumb.active('Login') }}
{% endblock %}

{% block content %}
    <div class="container">
        {{ include('Flash/_flash.html.twig') }}

        <div class="login-card">
            <div class="text-center mb-4">
                <h1 class="h3 mb-1">Einloggen und losfahren!</h1>
                <p class="text-muted mb-0">Mit Passkey, per E-Mail oder über Facebook bzw. Strava.</p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    {# Blendet sich samt Trennlinie selbst aus, wenn der Browser kein WebAuthn kann. #}
                    <div data-controller="passkey"
                         data-passkey-conditional-value="true"
                         data-passkey-redirect-url-value="{{ path('criticalmass_user_usermanagement') }}">
                        <button type="button"
                                class="btn btn-primary btn-lg w-100"
                                data-action="passkey#login"
                                data-passkey-target="submit">
                            <i class="far fa-key me-2"></i>Mit Passkey anmelden
                        </button>
                        <p class="small text-muted text-center mt-2 mb-0">
                            Per Fingerabdruck, Gesicht oder Geräte-PIN &mdash; ohne auf eine Mail zu warten.
                        </p>

                        <div class="alert alert-danger mt-3 mb-0" data-passkey-target="status" hidden></div>

                        <div class="login-divider">oder per E-Mail</div>
                    </div>

                    {{ form_start(login_form) }}
                        {{ form_row(login_form.email) }}
                        {{ form_row(login_form.remember_me, { 'help': null }) }}
                        <div class="frc-captcha mb-3" data-sitekey="{{ app.request.server.get('FRIENDLYCAPTCHA_SITE_KEY') }}"></div>
                        {{ form_widget(login_form.submit, { 'attr': { 'class': 'btn btn-outline-primary w-100' }, 'label': 'Anmeldelink zusenden' }) }}
                    {{ form_end(login_form) }}

                    <div class="login-divider">oder über</div>

                    <div class="d-flex gap-2">
                        <a class="btn btn-facebook flex-fill"
                           href="{{ path('hwi_oauth_service_redirect', {'service': 'facebook' }) }}">
                            <i class="fab fa-facebook-f me-1" aria-hidden="true"></i>Facebook
                        </a>
                        <a class="btn btn-strava flex-fill"
                           href="{{ path('hwi_oauth_service_redirect', {'service': 'strava' }) }}">
                            <i class="fab fa-strava me-1" aria-hidden="true"></i>Strava
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
