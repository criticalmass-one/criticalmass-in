{% extends 'Template/StandardTemplate.html.twig' %}
{% import 'Template/Macros/breadcrumb.html.twig' as breadcrumb %}
{% import 'Template/Macros/forum.html.twig' as forum %}

{% block title %}Beiträge von {{ author.username }}{% endblock %}

{% block breadcrumb %}
    {{ breadcrumb.item('Neues aus den Städten', path('caldera_criticalmass_status_feed')) }}
    {{ breadcrumb.active(author.username) }}
{% endblock %}

{% block content %}
    <div class="container">
        {{ include('Flash/_flash.html.twig') }}

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body d-flex align-items-center">
                <div class="flex-shrink-0 me-3">
                    {{ forum.avatar(author, 64) }}
                </div>
                <div class="flex-grow-1">
                    <h1 class="h4 mb-1">{{ author.username }}</h1>
                    <p class="text-muted mb-0">
                        {{ posts.totalItemCount }} {{ posts.totalItemCount == 1 ? 'Beitrag' : 'Beiträge' }}
                        {% if author.createdAt %}
                            &middot; dabei seit {{ author.createdAt|date('m/Y', 'Europe/Berlin') }}
                        {% endif %}
                    </p>
                </div>
                <a href="{{ path('caldera_criticalmass_forum_profile', { 'username': author.username }) }}" class="btn btn-outline-secondary btn-sm">
                    Im Forum
                </a>
            </div>
        </div>

        {{ include('StatusPost/_list.html.twig', {
            'emptyText': author.username ~ ' hat noch keinen Beitrag geschrieben.'
        }) }}
    </div>
{% endblock %}
