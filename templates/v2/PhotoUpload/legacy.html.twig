{% extends 'v2/Layout/standard.html.twig' %}

{% set city = ride.city %}

{% block title %}Fotos hochladen{% endblock %}

{% block content %}
    <div class="cm-crumb-link">
        <a href="{{ object_path(city) }}">{{ city.city }}</a> / <a href="{{ object_path(ride) }}">{{ ride.dateTime|format_datetime(pattern="d. MMMM yyyy", timezone=city.timezone) }}</a>
    </div>

    <div class="cm-page-head">
        <h1>Fotos hochladen</h1>
    </div>

    <section class="cm-card cm-pad cm-acc-form">
        {{ form_start(form, { action: object_path(ride, 'caldera_criticalmass_gallery_legacy_photos_upload_ride'), attr: { enctype: 'multipart/form-data' } }) }}
            {{ form_row(form.imageFile, { label: 'Foto' }) }}

            <p class="cm-pp-legal">Mit dem Hochladen von Foto-Dateien bestätigst du, dass du der Urheber dieser Fotos bist. Bitte lade keine Fotos hoch, an denen du keine Urheberrechte besitzt.</p>

            <div class="cm-btn-row">
                <button type="submit" class="cm-btn cm-btn-go">Datei hochladen</button>
                <a class="cm-btn" href="{{ object_path(ride, 'caldera_criticalmass_photo_ride_list') }}">Zur Galerie ({{ ride.photos|filter(p => p.enabled and not p.deleted)|length }})</a>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}

{% block rail %}
    {% include 'v2/PhotoUpload/_rail.html.twig' with { ride: ride } %}
{% endblock %}
