{% extends 'v2/Layout/standard.html.twig' %}

{% block title %}Beiträge von {{ author.username }}{% endblock %}

{% block content %}
    <div class="cm-crumb"><a href="{{ path('caldera_criticalmass_status_feed') }}">Beiträge</a></div>

    <section class="cm-card cm-forum-profile">
        {% include 'v2/Layout/_avatar.html.twig' with { user: author } %}
        <div>
            <h1>{{ author.username }}</h1>
            <p>
                {{ posts.totalItemCount }} {{ posts.totalItemCount == 1 ? 'Beitrag' : 'Beiträge' }}
                {%- if author.createdAt %}, dabei seit {{ author.createdAt|date('m/Y', 'Europe/Berlin') }}{% endif %}
            </p>
        </div>
        <a class="cm-btn" href="{{ path('caldera_criticalmass_forum_profile', { 'username': author.username }) }}">Im Forum</a>
    </section>

    {% include 'v2/StatusPost/_list.html.twig' with {
        posts: posts,
        emptyText: author.username ~ ' hat noch keinen Beitrag geschrieben.'
    } %}
{% endblock %}
