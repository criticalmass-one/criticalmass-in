{% extends 'v2/Layout/standard.html.twig' %}

{% set title = cityCycle.id ? 'Turnus bearbeiten' : 'Turnus hinzufügen' %}
{% set fixedHelp = cityCycle.hasSpecialCalculator() ? 'Wird von einem speziellen Generator festgelegt.' : null %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    {% include 'v2/CityCycle/_head.html.twig' with { city: city, heading: title } %}

    {{ form_start(form, { attr: { class: 'cm-card cm-form' } }) }}
        {{ form_errors(form) }}

        <fieldset>
            <legend>Termin</legend>

            <div class="cm-form-row">
                {{ form_row(form.dayOfWeek, { label: 'Wochentag', help: fixedHelp }) }}
                {{ form_row(form.weekOfMonth, { label: 'Woche im Monat', help: fixedHelp }) }}
            </div>

            <div class="cm-form-row">
                {{ form_row(form.time, { label: 'Uhrzeit' }) }}
            </div>
        </fieldset>

        <fieldset>
            <legend>Treffpunkt</legend>

            {{ form_row(form.location, { label: 'Name des Treffpunkts', help: 'Den Marker auf der Karte auf den Treffpunkt ziehen.' }) }}

            <div class="cm-form-map"
                 data-controller="map--form-map"
                 data-map--form-map-center-latitude-value="{{ city.latitude }}"
                 data-map--form-map-center-longitude-value="{{ city.longitude }}"
                 data-map--form-map-zoom-value="10"
                 data-map--form-map-marker-latitude-target-value="{{ form.latitude.vars.id }}"
                 data-map--form-map-marker-longitude-target-value="{{ form.longitude.vars.id }}"
                 data-map--form-map-marker-icon-value="fa-map-marker-alt"
                 data-map--form-map-marker-color-value="yellow"
                 data-map--form-map-marker-shape-value="circle"
                 data-map--form-map-marker-prefix-value="fas">
            </div>
            {{ form_widget(form.latitude) }}
            {{ form_widget(form.longitude) }}
        </fieldset>

        <fieldset>
            <legend>Gültigkeit</legend>

            <div class="cm-form-row">
                {{ form_row(form.validFrom, { label: 'Gültig ab' }) }}
                {{ form_row(form.validUntil, { label: 'Gültig bis' }) }}
            </div>
        </fieldset>

        <div class="cm-form-submit">
            <a class="cm-adm-aside" href="{{ object_path(city, 'caldera_criticalmass_ride_add') }}">Einzelne Tour eintragen</a>
            <a class="cm-btn" href="{{ object_path(city) }}">Abbrechen</a>
            <button type="submit" class="cm-btn cm-btn-go">Speichern</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
