{% set today = 'today'|date('Y-m-d') %}
{% set shownDays = 0 %}

{% for month in rideList %}
    {% for day in month %}
        {% if shownDays < 3 and day.dateTime|date('Y-m-d') >= today %}
            {% set shownDays = shownDays + 1 %}
            {% set rides = [] %}
            {% for ride in day %}{% set rides = rides|merge([ride]) %}{% endfor %}
            <div class="cm-box">
                <h3>{{ day.dateTime|date('Y-m-d') == today ? 'Heute, ' }}{{ day.dateTime|format_datetime(pattern="EEEE, d. MMMM") }}</h3>
                <div class="cm-sub">{{ rides|length }} {{ rides|length == 1 ? 'Tour' : 'Touren' }}</div>

                {% for ride in rides|slice(0, 10) %}
                    {% set zone = ride.city.timezone %}
                    {% set ridePath = object_path(ride) %}
                    {% set tag = ridePath ? 'a' : 'div' %}
                    <{{ tag }} class="cm-ride{% if not ride.enabled %} cm-ride-off{% endif %}"{% if ridePath %} href="{{ ridePath }}"{% endif %}>
                        <span class="cm-t">{{ ride.dateTime ? ride.dateTime|date('H:i', zone) }}</span>
                        <span class="cm-c">{{ ride.city.city }}{% if not ride.enabled %} <span class="cm-dim">(abgesagt)</span>{% endif %}</span>
                        {% if ride.location %}<span class="cm-p">{{ ride.location }}</span>{% endif %}
                    </{{ tag }}>
                {% endfor %}

                {% if rides|length > 10 %}
                    <a class="cm-more" href="{{ path('caldera_criticalmass_calendar') }}">Alle {{ rides|length }} im Kalender</a>
                {% endif %}
            </div>
        {% endif %}
    {% endfor %}
{% endfor %}

{% if shownDays == 0 %}
    <div class="cm-box">
        <h3>Bald unterwegs</h3>
        <p class="cm-dim mb-0">In den nächsten Wochen ist keine Tour eingetragen.</p>
    </div>
{% endif %}

<a class="cm-more" href="{{ path('caldera_criticalmass_calendar') }}">Zum Kalender</a>
