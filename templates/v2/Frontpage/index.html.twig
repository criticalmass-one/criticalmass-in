{% extends 'v2/Layout/standard.html.twig' %}

{% block title %}criticalmass.in{% endblock %}

{% block content %}
    {% for teaser in frontpageTeaserList %}
        <section class="cm-card cm-teaser">
            {% if teaser.imageName %}
                <img src="{{ vich_uploader_asset(teaser, 'imageFile')|imagine_filter('frontpage_teaser_large') }}" alt="">
            {% endif %}
            <div class="cm-pad">
                {% if teaser.headline %}<h2>{{ teaser.headline }}</h2>{% endif %}
                {% if teaser.text %}<p>{{ teaser.text }}</p>{% endif %}
                {% if teaser.buttons is not empty %}
                    <div class="cm-btn-row">
                        {% for button in teaser.buttons %}
                            {% if button.link %}
                                <a class="cm-btn{{ loop.first ? ' cm-btn-go' }}" href="{{ button.link }}">{{ button.caption }}</a>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </section>
    {% endfor %}

    {{ include('Timeline/timeline.html.twig') }}

    <a class="cm-more" href="{{ path('caldera_criticalmass_timeline_index') }}">Ältere Einträge</a>
{% endblock %}

{% block rail %}
    {{ render(controller('App\\Controller\\FrontpageController::rideListAction')) }}
{% endblock %}
