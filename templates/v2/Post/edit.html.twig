{% extends 'v2/Layout/standard.html.twig' %}

{% set backUrl = object_path(post.thread ?? post.ride ?? post.city ?? post.photo) %}

{% block title %}Beitrag bearbeiten{% endblock %}

{% block content %}
    {% if post.thread %}
        <div class="cm-crumb">
            <a href="{{ path('caldera_criticalmass_board_overview') }}">Forum</a> /
            <a href="{{ object_path(post.thread) }}">{{ post.thread.title }}</a>
        </div>
    {% endif %}
    <div class="cm-forum-head"><h1>Beitrag bearbeiten</h1></div>

    <section class="cm-card cm-forum-form">
        {{ form_start(form) }}
        {{ form_errors(form) }}

        <label class="form-label" for="{{ form.text.vars.id }}">Beitrag</label>
        {% include 'v2/Board/_editor.html.twig' with { field: form.text, rows: 10 } %}
        {{ form_errors(form.text) }}

        <div class="cm-form-foot">
            <a class="cm-btn" href="{{ backUrl }}">Abbrechen</a>
            <button type="submit" class="cm-btn cm-btn-go">Speichern</button>
        </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
