{% set route = app.request.attributes.get('_route') ?? '' %}
<aside class="cm-sidenav">
    <a class="cm-brand" href="{{ path('caldera_criticalmass_frontpage') }}">
        <svg width="26" height="26" aria-hidden="true"><use href="#i-bike"/></svg>criticalmass.in
    </a>

    <form class="cm-search" role="search" action="{{ path('caldera_criticalmass_search_query') }}" data-controller="search">
        <svg width="16" height="16" aria-hidden="true"><use href="#i-search"/></svg>
        <input type="search" name="query" placeholder="Stadt oder Tour suchen" aria-label="Suche"
               data-search-target="input" autocomplete="off">
        <div class="dropdown-menu d-none" data-search-target="results"></div>
    </form>

    <nav aria-label="Hauptnavigation">
        {% include 'v2/Layout/_nav_items.html.twig' with { route: route } %}
    </nav>

    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
        <a class="cm-upload" href="{{ path('caldera_criticalmass_unified_upload') }}">Hochladen</a>

        <a class="cm-me" href="{{ path('criticalmass_user_usermanagement') }}">
            {% include 'v2/Layout/_avatar.html.twig' with { user: app.user, small: true } %}
            <span>{{ app.user.username }}</span>
        </a>
    {% else %}
        <a class="cm-upload" href="{{ path('login') }}">Anmelden</a>
    {% endif %}
</aside>
