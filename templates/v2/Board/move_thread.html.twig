{% extends 'v2/Layout/standard.html.twig' %}

{% block title %}Thema verschieben{% endblock %}

{% block content %}
    <div class="cm-crumb">
        <a href="{{ path('caldera_criticalmass_board_overview') }}">Forum</a> /
        <a href="{{ object_path(thread) }}">{{ thread.title }}</a>
    </div>
    <div class="cm-forum-head">
        <div>
            <h1>Thema verschieben</h1>
            <p>Liegt zurzeit in {{ board.title }}</p>
        </div>
    </div>

    <section class="cm-card cm-forum-form">
        {{ form_start(form) }}
        {{ form_errors(form) }}

        <label class="form-label" for="{{ form.target.vars.id }}">Neues Forum</label>
        {{ form_widget(form.target, { 'attr': { 'class': 'form-select' } }) }}
        {{ form_errors(form.target) }}
        <div class="form-text">Die Zähler beider Foren werden mitgezogen.</div>

        {{ form_rest(form) }}

        <div class="cm-form-foot">
            <a class="cm-btn" href="{{ object_path(thread) }}">Abbrechen</a>
            <button type="submit" class="cm-btn cm-btn-go">Verschieben</button>
        </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
