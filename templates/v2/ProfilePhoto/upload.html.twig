{% extends 'v2/Layout/standard.html.twig' %}

{% block title %}Profilfoto hochladen{% endblock %}

{% block content %}
    <div class="cm-page-head">
        <div class="cm-crumb"><a href="{{ path('criticalmass_user_usermanagement') }}">Dein Konto</a></div>
        <h1>Profilfoto</h1>
    </div>

    <section class="cm-card cm-pad cm-acc-form">
        <div class="cm-acc-photo">
            {% if app.user.imageName %}
                <img src="{{ vich_uploader_asset(app.user, 'imageFile')|imagine_filter('user_profile_photo_medium') }}" alt="Dein Profilfoto">
            {% else %}
                {% include 'v2/Layout/_avatar.html.twig' with { user: app.user } %}
            {% endif %}
        </div>

        {{ form_start(profilePhotoForm) }}
            {{ form_row(profilePhotoForm.imageFile, { label: 'Neues Foto' }) }}

            <div class="cm-btn-row">
                {{ form_widget(profilePhotoForm.submit, { label: 'Speichern', attr: { class: 'cm-btn cm-btn-go' } }) }}
                <a href="{{ path('criticalmass_user_usermanagement') }}" class="cm-btn">Abbrechen</a>
            </div>
        {{ form_end(profilePhotoForm) }}
    </section>
{% endblock %}

{% block rail %}
    {% include 'v2/ProfileManagement/_rail.html.twig' %}
{% endblock %}
