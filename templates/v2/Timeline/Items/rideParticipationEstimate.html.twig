{% set action %}hat die <a href="{{ object_path(item.ride) }}">{{ item.rideTitle }}</a> geschätzt{% endset %}
<article class="cm-card cm-post{% if not item.rideEnabled %} cm-post-disabled{% endif %}">
    {% include 'Timeline/_includes/head.html.twig' with { action: action, where: include('Timeline/_includes/ride_when.html.twig', { ride: item.ride }) } %}

    <div class="cm-figures">
        <div><b>{{ item.estimatedParticipants|number_format(0, ',', '.') }}</b><small>Teilnehmende geschätzt</small></div>
    </div>
</article>
