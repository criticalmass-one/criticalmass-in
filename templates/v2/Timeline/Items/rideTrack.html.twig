{% set action %}hat einen Track von der <a href="{{ object_path(item.ride) }}">{{ item.rideTitle }}</a> hochgeladen{% endset %}
<article class="cm-card cm-post{% if not item.rideEnabled %} cm-post-disabled{% endif %}">
    {% include 'Timeline/_includes/head.html.twig' with { action: action, where: include('Timeline/_includes/ride_when.html.twig', { ride: item.ride }) } %}

    {% if item.polyline %}
        <div class="cm-map"
             id="map-{{ item.uniqId }}"
             data-controller="map--map"
             data-map--map-center-latitude-value="{{ item.ride.latitude }}"
             data-map--map-center-longitude-value="{{ item.ride.longitude }}"
             data-map--map-zoom-value="12"
             data-map--map-lock-map-value="true"
             data-map--map-polyline-color-value="#f4581c"
             data-map--map-polyline-value="{{ item.track.getPolylineString(constant('App\\Enum\\PolylineResolution::COARSE')) }}"
             data-map--map-vector-value="false">
        </div>
    {% endif %}

    <div class="cm-figures">
        <div><b>{{ item.distance|number_format(1, ',', '.') }} km</b><small>Strecke</small></div>
        <div><b>{{ human_duration(item.duration) }}</b><small>unterwegs</small></div>
    </div>
</article>
