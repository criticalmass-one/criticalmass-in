{# Parameter: item, action, where (optional), disabled (optional) #}
<article class="cm-card cm-post-compact{% if disabled|default(false) %} cm-post-disabled{% endif %}">
    {% if item.user %}
        {% include 'v2/Layout/_avatar.html.twig' with { user: item.user, small: true } %}
    {% else %}
        <span class="cm-ava cm-ava-s cm-ava-ini cm-ava-anon" aria-hidden="true"></span>
    {% endif %}
    <p>
        {% if item.user %}<b>{{ item.user.username }}</b>{% else %}Jemand{% endif %} {{ action }}
        <span class="cm-when"><time datetime="{{ item.dateTime|date('c') }}">{{ item.dateTime|time_ago_in_words }}</time>{% if where is defined and where %}, {{ where }}{% endif %}</span>
    </p>
</article>
