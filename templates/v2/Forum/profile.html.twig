{% extends 'v2/Layout/standard.html.twig' %}

{% block title %}{{ forumUser.username }} im Forum{% endblock %}

{% block content %}
    <div class="cm-crumb"><a href="{{ path('caldera_criticalmass_board_overview') }}">Forum</a></div>

    <section class="cm-card cm-forum-profile">
        {% include 'v2/Layout/_avatar.html.twig' with { user: forumUser } %}
        <div>
            <h1>{{ forumUser.username }}</h1>
            <p>
                {{ forumUser.forumRank }}, {{ forumUser.forumPostCount }} {{ forumUser.forumPostCount == 1 ? 'Beitrag' : 'Beiträge' }}
                {%- if forumUser.createdAt %}, dabei seit {{ forumUser.createdAt|date('m/Y', 'Europe/Berlin') }}{% endif %}
            </p>
        </div>
        {% if feature('status_posts') %}
            <a class="cm-btn" href="{{ path('caldera_criticalmass_status_user', { 'username': forumUser.username }) }}">Beiträge in den Städten</a>
        {% endif %}
    </section>

    <h2 class="cm-forum-h2">Letzte Beiträge</h2>

    {% if posts|length == 0 %}
        <p class="cm-card cm-forum-empty">{{ forumUser.username }} hat noch nichts im Forum geschrieben.</p>
    {% else %}
        <section class="cm-card">
            <ul class="cm-hits">
                {% for post in posts %}
                    <li>
                        <a href="{{ object_path(post.thread) }}#post-{{ post.id }}">{{ post.thread.title }}</a>
                        <p>{{ post.text|search_snippet('') }}</p>
                        <small>{{ post.dateTime|date('d.m.Y, H:i', 'Europe/Berlin') }}</small>
                    </li>
                {% endfor %}
            </ul>
        </section>
        {% include 'v2/Board/_pager.html.twig' with { items: posts } %}
    {% endif %}
{% endblock %}
