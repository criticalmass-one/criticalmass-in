{# Parameter: pagination #}
{% set page = pagination.currentPageNumber %}
{% set pages = (pagination.totalItemCount / pagination.itemNumberPerPage)|round(0, 'ceil') %}
{% if pages > 1 %}
    {% set route = pagination.route %}
    {% set params = pagination.params %}
    <nav class="cm-pagenav" aria-label="Seiten">
        {% if page > 1 %}
            <a class="cm-btn" href="{{ path(route, params|merge({ page: page - 1 })) }}">Vorige Seite</a>
        {% else %}
            <span></span>
        {% endif %}
        <span>Seite {{ page }} von {{ pages }}</span>
        {% if page < pages %}
            <a class="cm-btn" href="{{ path(route, params|merge({ page: page + 1 })) }}">Nächste Seite</a>
        {% else %}
            <span></span>
        {% endif %}
    </nav>
{% endif %}
