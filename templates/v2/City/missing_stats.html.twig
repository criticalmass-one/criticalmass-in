{% extends 'v2/Layout/wide.html.twig' %}

{% block title %}Touren mit fehlenden Statistiken aus {{ city.city }}{% endblock %}

{% block content %}
    {% include 'v2/City/Includes/_head.html.twig' with { city: city, tab: 'statistic', heading: city.title } %}

    <section class="cm-card cm-sect">
        <h2>Fehlende Statistiken{% if rides|length > 0 %} <span class="cm-cnt">{{ rides|length }}</span>{% endif %}<a href="{{ object_path(city, 'caldera_criticalmass_statistic_city') }}">Zur Statistik</a></h2>
        {% if rides|length > 0 %}
            {% include 'v2/City/Includes/_ride_table.html.twig' with { rides: rides } %}
        {% else %}
            <p class="cm-empty">Für alle Touren in {{ city.city }} sind Statistiken vorhanden.</p>
        {% endif %}
    </section>
{% endblock %}
