{% extends 'v2/Layout/standard.html.twig' %}

{% block title %}Farbe wählen{% endblock %}

{% block content %}
    <div class="cm-page-head">
        <div class="cm-crumb"><a href="{{ path('criticalmass_user_usermanagement') }}">Dein Konto</a></div>
        <h1>Profilfarbe</h1>
    </div>

    <section class="cm-card cm-pad cm-acc-form">
        {{ form_start(profileColorForm) }}
            {{ form_row(profileColorForm.color, { label: 'Farbe', help: 'In dieser Farbe erscheinen deine Tracks auf der Karte.', attr: { class: 'cm-acc-color' } }) }}

            <div class="cm-btn-row">
                {{ form_widget(profileColorForm.submit, { label: 'Speichern', attr: { class: 'cm-btn cm-btn-go' } }) }}
                <a href="{{ path('criticalmass_user_usermanagement') }}" class="cm-btn">Abbrechen</a>
            </div>
        {{ form_end(profileColorForm) }}
    </section>
{% endblock %}

{% block rail %}
    {% include 'v2/ProfileManagement/_rail.html.twig' %}
{% endblock %}
