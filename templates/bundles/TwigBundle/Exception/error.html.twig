{# Alle übrigen Fehler, vor allem 5xx: ohne Rahmen, ohne Assets, ohne Datenbank.
   Scheitert diese Vorlage, rendert Symfony sie für die neue Ausnahme (500) gleich
   noch einmal; der ursprüngliche Status geht dabei verloren. #}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Fehler {{ status_code }} — criticalmass.in</title>
    <style>
        body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #f2f3f5; color: #34373d; font: 16px/1.5 "Helvetica Neue", Arial, sans-serif; }
        main { background: #fff; border: 1px solid #dfe1e5; border-radius: 12px; padding: 28px 32px; margin: 16px; max-width: 420px; }
        h1 { margin: 0 0 8px; font-size: 1.5rem; color: #16181c; }
        p { margin: 0 0 16px; }
        a { color: #c23e0d; }
    </style>
</head>
<body>
    <main>
        <h1>Fehler {{ status_code }}</h1>
        {% set texts = {
            400: 'Die Anfrage war fehlerhaft.',
            401: 'Dafür musst du angemeldet sein.',
            405: 'Diese Anfrage ist hier nicht erlaubt.',
            408: 'Die Anfrage hat zu lange gedauert.',
            410: 'Diese Seite gibt es nicht mehr.',
            429: 'Zu viele Anfragen.',
            500: 'Auf dem Server ist ein Fehler aufgetreten.',
            502: 'Der Server hat eine ungültige Antwort erhalten.',
            503: 'Die Seite wird gerade gewartet.',
            504: 'Der Server hat nicht rechtzeitig geantwortet.',
        } %}
        {% if texts[status_code] is defined %}
            <p>{{ texts[status_code] }}</p>
        {% endif %}
        <a href="{{ path('caldera_criticalmass_frontpage') }}">Zur Startseite</a>
    </main>
</body>
</html>
