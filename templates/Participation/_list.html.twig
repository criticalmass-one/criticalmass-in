<div class="row">
    <div class="col-md-12">
        {% if participationList|length > 0 %}
        <table class="table">
            <thead>
            <tr>
                <th>
                    Tour
                </th>

                <th>
                    Stadt
                </th>

                <th>
                    Datum
                </th>

                <th>

                </th>
            </tr>
            </thead>
            <tbody>
            {% for participation in participationList %}
                <tr>
                    <td>
                        <a href="{{ object_path(participation.ride) }}">
                            {{ participation.ride.title }}
                        </a>
                    </td>

                    <td>
                        <a href="{{ object_path(participation.ride.city) }}">
                            {{ participation.ride.city.city }}
                        </a>
                    </td>

                    <td>
                        {{ participation.ride.dateTime|date('d.m.Y H:i') }}&nbsp;Uhr
                    </td>

                    <td class="text-nowrap">
                        <form method="post" action="{{ path('criticalmass_user_participation_delete', { id: participation.id }) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('participation_delete_' ~ participation.id) }}">
                            <button type="submit" class="btn btn-secondary btn-sm" title="Diesen Eintrag komplett löschen">
                                <i class="far fa-trash-alt"></i>
                            </button>
                        </form>

                        {% if not participation.goingYes %}
                        <form method="post" action="{{ path('criticalmass_user_participation_update', { id: participation.id }) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('participation_update_' ~ participation.id) }}">
                            <input type="hidden" name="status" value="yes">
                            <button type="submit" class="btn btn-success btn-sm" title="Deine Teilnahme speichern">
                                <i class="far fa-check"></i>
                            </button>
                        </form>
                        {% endif %}

                        {% if not participation.goingNo %}
                        <form method="post" action="{{ path('criticalmass_user_participation_update', { id: participation.id }) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('participation_update_' ~ participation.id) }}">
                            <input type="hidden" name="status" value="no">
                            <button type="submit" class="btn btn-danger btn-sm" title="Deine Teilnahme zurückziehen">
                                <i class="far fa-times"></i>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
            <div class="alert alert-info">
                Für diese Liste wurden keine Datensätze gefunden.
            </div>
        {% endif %}
    </div>
</div>
