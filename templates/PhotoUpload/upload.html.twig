{% extends 'Template/StandardTemplate.html.twig' %}
{% import 'Template/Macros/breadcrumb.html.twig' as breadcrumb %}

{% set city = ride.city %}

{% block title %}Fotos hochladen{% endblock %}

{% block breadcrumb %}
    {{ breadcrumb.item(city.title, object_path(city)) }}
    {{ breadcrumb.item(ride.title, object_path(ride)) }}
    {{ breadcrumb.active('Fotos hochladen') }}
{% endblock %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1>
                    Fotos hochladen
                </h1>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <p>
                    Fotos lädst du einzeln über unseren Foto-Uploader zu dieser Tour hoch. Wenn du vorher einen
                    GPX-Track deiner Tour hochlädst oder deine Fotos GPS-Koordinaten enthalten, werden deine Fotos
                    automatisch auf der Karte verortet.
                </p>

                <a class="btn btn-success"
                   href="{{ object_path(ride, 'caldera_criticalmass_gallery_legacy_photos_upload_ride') }}">
                    <i class="far fa-camera"></i>
                    Zum Foto-Uploader
                </a>
            </div>
        </div>
    </div>
{% endblock %}
