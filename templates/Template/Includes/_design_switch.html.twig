{% if design_switch_available() %}
    <form method="post" action="{{ path('criticalmass_design_switch') }}" class="mt-2">
        <input type="hidden" name="_token" value="{{ csrf_token('design-switch') }}">
        <input type="hidden" name="_target" value="{{ app.request.requestUri }}">
        <input type="hidden" name="design" value="{{ design_v2() ? 'v1' : 'v2' }}">
        <button type="submit" class="btn btn-link p-0 text-start">
            {{ design_v2() ? 'Zur bisherigen Ansicht' : 'Neue Ansicht ausprobieren' }}
        </button>
    </form>
{% endif %}
