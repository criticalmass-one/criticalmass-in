{
    "name": "calderacc/criticalmass",
    "type": "project",
    "version": "0.1",
    "description": "Much critical mass stuff",
    "authors": [
        {
            "name": "Malte Hübner",
            "email": "malte@caldera.cc",
            "homepage": "https://www.maltehuebner.de/",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "ext-simplexml": "*",
        "doctrine/orm": "^3.6",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "vich/uploader-bundle": "^3.0",
        "liip/imagine-bundle": "^2.18",
        "knplabs/knp-paginator-bundle": "^6.11",
        "emcconville/google-map-polyline-encoding-tool": ">=1.2.1",
        "symfony/monolog-bundle": "^4.1",
        "hwi/oauth-bundle": "^2.5",
        "malenki/slug": "1.0.0",
        "sonata-project/intl-bundle": "^3.3",
        "miljar/php-exif": "^0.6.5",
        "sonata-project/seo-bundle": "^3.9",
        "salavert/time-ago-in-words": "^1.8",
        "emcconville/point-reduction-algorithms": "^1.2",
        "php-http/message": "^1.6",
        "symfony/security-bundle": "8.1.*",
        "symfony/apache-pack": "^1.0",
        "symfony/flex": "^2.0",
        "khill/php-duration": "^1.0",
        "sabre/vobject": "^4.0",
        "oneup/flysystem-bundle": "^4.14.1",
        "flagception/flagception-bundle": "^6.1.1",
        "ext-fileinfo": "*",
        "ext-xmlwriter": "*",
        "symfony/webpack-encore-bundle": "^2.4.2",
        "ext-json": "*",
        "ext-zip": "*",
        "league/commonmark": "^2.10",
        "nesbot/carbon": "^3.0",
        "iamstuartwilson/strava": "^1.4",
        "embed/embed": "^4.1",
        "twig/extra-bundle": "^3.29",
        "nyholm/psr7": "^1.3",
        "knplabs/knp-menu-bundle": "^3.8",
        "maltehuebner/ordered-entities-bundle": "^0.4",
        "symfony/doctrine-bridge": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "jaybizzle/crawler-detect": "^1.2",
        "nelmio/api-doc-bundle": "^5.13",
        "symfony/asset": "8.1.*",
        "yohang/calendr": "^4.0",
        "presta/sitemap-bundle": "^4.3.1",
        "symfony/http-client": "8.1.*",
        "symfony/twig-bridge": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/cache": "8.1.*",
        "symfony/notifier": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "twig/cssinliner-extra": "^3.26",
        "twig/inky-extra": "^3.26",
        "symfony/serializer": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/stimulus-bundle": "^2.36",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/messenger": "8.1.*",
        "beberlei/doctrineextensions": "^1.5",
        "sibyx/phpgpx": "^1.3",
        "twig/intl-extra": "^3.29",
        "maltehuebner/dataquery-bundle": "^0.11.2",
        "symfony/rate-limiter": "8.1.*",
        "symfony/lock": "8.1.*",
        "adriangibbons/php-fit-file-analysis": "^3.2",
        "league/oauth2-server-bundle": "^2.0",
        "jsor/doctrine-postgis": "^2.4",
        "web-auth/webauthn-symfony-bundle": "^5.3.9"
    },
    "require-dev": {
        "symfony/browser-kit": "8.1.*",
        "symfony/phpunit-bridge": "8.1.*",
        "phpunit/phpunit": "^11.5",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "rector/rector": "^2.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "scripts": {
        "post-install-cmd": [
        ],
        "post-update-cmd": [
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "cache:warmup": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "test:db:reset": [
            "php bin/console --env=test doctrine:schema:drop --force --full-database",
            "php bin/console --env=test doctrine:schema:create",
            "php bin/console --env=test doctrine:fixtures:load --no-interaction"
        ],
        "test:run": [
            "php vendor/bin/phpunit"
        ],
        "test:api": [
            "php vendor/bin/phpunit --testsuite 'API Tests'"
        ],
        "test": [
            "@test:db:reset",
            "@test:run"
        ],
        "tests": [
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "audit": {
            "abandoned": "report",
            "block-insecure": false
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/maltehuebner/StravaPHP.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/maltehuebner/time-ago-in-words.git"
        }
    ],
    "minimum-stability": "stable"
}
